{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "larder-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "larder-dev-perf",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set PERF_TIMING=1&& npm run dev -- --port 3100"],
      "port": 3100
    }
  ]
}
